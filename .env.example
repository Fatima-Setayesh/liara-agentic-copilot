# Browser-safe values only. Never put credentials in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APP_NAME="Liara Agentic Developer Copilot"

# Server-only AvalAI configuration. Never use a Liara management API key here.
AVALAI_API_KEY="replace-with-avalai-api-key"
AVALAI_BASE_URL="https://api.avalai.ir/v1"
AVALAI_MODEL="replace-with-avalai-model-id"
AI_REQUEST_TIMEOUT_MS="45000"
AI_MAX_OUTPUT_TOKENS="1200"
AI_RETRIEVAL_LIMIT="6"

# Authoritative Liara knowledge locations (non-secret).
LIARA_DOCS_BASE_URL="https://docs.liara.ir"
LIARA_DOCS_REPOSITORY_URL="https://github.com/liara-cloud/docs.git"
LIARA_DOCS_REPOSITORY_PATH="replace-with-absolute-pinned-checkout-path"
LIARA_DOCS_REVISION="replace-with-full-40-character-git-revision"

# Server-only operational configuration.
LOG_LEVEL="info"
